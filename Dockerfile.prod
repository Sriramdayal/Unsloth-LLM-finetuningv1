# Dockerfile.prod
# Production image for the Unsloth LLM Fine-Tuning API.
# Serves FastAPI via Gunicorn + Uvicorn worker.
#
# Build:  docker build -f Dockerfile.prod -t unsloth-api .
# Run:    docker run -p 8000:8000 --gpus all -e HF_TOKEN=$HF_TOKEN unsloth-api

FROM python:3.11-slim

WORKDIR /app

# Install system deps for torch, llama.cpp build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libopenblas-dev && \
    rm -rf /var/lib/apt/lists/*

# Install Python deps (editable install with api extra)
COPY pyproject.toml .
RUN pip install --no-cache-dir -e ".[api]"

# Copy application code
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY config.yaml .

# Non-root user for security
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# Gunicorn with a single Uvicorn worker (GPU models are not fork-safe)
CMD ["gunicorn", "-w", "1", "-k", "uvicorn.workers.UvicornWorker", \
     "src.api:app", "--bind", "0.0.0.0:8000", "--timeout", "120"]
